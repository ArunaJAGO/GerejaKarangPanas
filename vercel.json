{
  "version": 2,
  "framework": null,
  "buildCommand": "npm install && npm run build",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.0"
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/(.*\\.(?:png|jpg|jpeg|gif|svg|webp|ico|css|js|mjs|json|woff|woff2|ttf|eot|pdf|mp4|webm|txt|xml))",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "outputDirectory": "public"
}
